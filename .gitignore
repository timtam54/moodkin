# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# android signing keys (sensitive)
/android-signing

# docs folder — ignore everything by default (may contain credentials, notes, etc.),
# allow-list files you actively want tracked
docs/*
!docs/.gitkeep
!docs/what-is-a-moodboard.md
!docs/moodkin-play-store-setup.md
!docs/AuthKey_9CR32328ZJ.p8


# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
docs/migrations
docs
